# Public URL once the domain is decided. Until set, search engines are blocked.
NEXT_PUBLIC_SITE_URL=https://example.com

# Neon Postgres connection string (Vercel > Storage > Neon adds this automatically)
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Admin login
ADMIN_PASSWORD=choose-a-long-password
# Random string, at least 32 characters. Generate with: openssl rand -base64 48
AUTH_SECRET=

# Vercel Blob for cover images (Vercel > Storage > Blob adds this automatically)
BLOB_READ_WRITE_TOKEN=
